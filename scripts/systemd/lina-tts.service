# LINA — her mouth, a local instrument (llama-tts + Qwen3-TTS gateway).
#
# Install:  sudo cp scripts/systemd/lina-tts.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now lina-tts.service
#
# Serves her service's OpenAI-compatible /audio/speech at 127.0.0.1:8082.

[Unit]
Description=LINA Mouth — her audible voice (llama-tts gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/home/server/LiNa_Discovery/backend/lina
EnvironmentFile=/home/server/LiNa_Discovery/.env
ExecStart=/home/server/LiNa_Discovery/.venv/bin/python -m uvicorn tts_gateway:app --host 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=3
# Her instruments never swap.
MemorySwapMax=0
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
